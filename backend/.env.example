# Variables de entorno del backend (FastAPI). Plantilla SIN valores reales:
# copiar a ".env" local y completar con los valores reales de Supabase (fase 2).
# Nunca versionar el archivo .env con valores reales.

APP_ENV=development

# Supabase (fase 2 — NO conectar todavía)
# URL base del proyecto de Supabase (para derivar el endpoint JWKS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection string directo a Postgres de Supabase (puerto 5432, no el pooler
# de transacciones por ahora — este backend corre como proceso persistente,
# no serverless, así que no necesita pgbouncer transaction mode todavía)
DATABASE_URL=
# Esquema de pruebas (P20). Vacio = las pruebas de integracion se omiten.
# El esquema `test` lo selecciona el fixture con search_path; la URL es la misma base.
DATABASE_URL_TEST=

# Nombre del almacén único usado por defecto (ver P19).
# Debe existir una fila en la tabla almacen con este nombre exacto
# (scripts/semilla.py la crea).
ALMACEN_PREDETERMINADO=Principal

# Datos ficticios de desarrollo (P4). "true" marca las predicciones como
# nivel_confianza='simulacion' con datos_ficticios=true; en el piloto debe
# quedar en "false" para que los pronosticos se registren como reales.
DATOS_FICTICIOS=false

# Orígenes permitidos por CORS, separados por coma (frontend web).
# En desarrollo el default es el servidor de Vite (5173). En el despliegue,
# definir el origen real del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
