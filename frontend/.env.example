# Variables de entorno del frontend (React + Vite). Plantilla SIN valores reales:
# copiar a ".env.local" y completar con los valores reales.
# Prefijo VITE_ requerido para que Vite las exponga al cliente.
# Nunca versionar el archivo .env.local con valores reales.

# URL de Supabase (Auth). La clave debe ser la publishable/anon, nunca la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL base de la API FastAPI en desarrollo.
VITE_API_URL=http://127.0.0.1:8000
# "true" muestra el aviso de datos ficticios (P4).
VITE_DATOS_FICTICIOS=false
# Nombre visible del sistema.
VITE_APP_NAME=Familia de la Cruz
