# Variables de entorno del frontend (React + Vite). Plantilla SIN valores reales:
# copiar a ".env.local" y completar con los valores reales de Supabase (fase 2).
# Prefijo VITE_ requerido para que Vite las exponga al cliente.
# Nunca versionar el archivo .env.local con valores reales.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=